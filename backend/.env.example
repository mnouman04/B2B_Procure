# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────
# Point at a local mongod or an Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017/procurio
# Leave false to use MONGO_URI. If that server is unreachable in development
# the API automatically starts an embedded MongoDB whose files live in
# .mongo-data/, so data survives restarts. Set true to force embedded mode.
USE_EMBEDDED_DB=false

# ── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# ── Uploads ────────────────────────────────────────────
UPLOAD_DIR=src/uploads
MAX_UPLOAD_MB=10

# ── Business rules ─────────────────────────────────────
VAT_RATE=0.15
DEFAULT_CURRENCY=SAR
PLATFORM_COMMISSION_RATE=0.02
